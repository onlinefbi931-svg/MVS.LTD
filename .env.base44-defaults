# Local development defaults for docker-compose.base44.yml.
#
# These are placeholders only — no real credentials live here. The platform
# delivers user-supplied values to /run/base44/app.env, which is listed AFTER
# this file in compose, so anything the user sets in the dashboard overrides
# these values. Nothing in this file is required for the app to start: the UI
# runs without M-Pesa credentials and only sending a prompt needs them.

MPESA_ENV=
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
# Leave empty to derive the callback URL from the preview host.
MPESA_CALLBACK_URL=
